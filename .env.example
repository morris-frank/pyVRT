# Copy to .env (or .env.local) — both are gitignored and auto-loaded by mise.
# pyvrt reads no secrets; these only steer where matplotlib writes its caches.

# --- matplotlib (src/pyvrt/runtime.py) ---
# Unset: pyvrt points each at a fresh temp dir, so a read-only HOME still works.
# MPLCONFIGDIR=      # not secret
# XDG_CACHE_HOME=    # not secret
